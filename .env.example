# Copy this file to .env.local and fill in the values. Never commit real keys.

# Which data layer the app uses. "mock" (default) keeps everything on the
# device; "supabase" needs the two variables below and the Supabase adapter.
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase project URL, e.g. https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public anon key. This value ships inside the phone app, so it must
# stay a public/anon key: never put a service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
